{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "paths": {
      "@nexus/shared": ["./shared/types/index.ts"],
      "@nexus/shared/*": ["./shared/*"]
    }
  },
  "include": ["shared/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules"]
}
