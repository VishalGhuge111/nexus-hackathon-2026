    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "prisma": "^6.14.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.11"
  }
}
