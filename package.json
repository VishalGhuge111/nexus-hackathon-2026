{
  "name": "nexus",
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "packageManager": "pnpm@10.15.0",
  "dependencies": {
    "@prisma/client": "^6.14.0"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev:web": "pnpm --dir web dev",
