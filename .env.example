# Pooled connection (PgBouncer) — used by the running app at request time (shared/db/prismaClient.ts).
DATABASE_URL=
# Direct, non-pooled connection — used only by the Prisma CLI for migrate/db push (prisma/schema.prisma directUrl).
DATABASE_URL_UNPOOLED=
ANTHROPIC_API_KEY=
FIREBASE_SERVICE_ACCOUNT_KEY=
NEXT_PUBLIC_FIREBASE_CONFIG=
# Supplier communication (PS §5.5/5.6, shared/email/brevoClient.ts) — server-side only,
# never exposed to the browser. Both must be set for supplier_message_send to actually
# email suppliers; if either is missing, communications are still recorded in the audit
# trail with emailStatus: NOT_CONFIGURED and the recovery engine is unaffected.
BREVO_API_KEY=
# Must be a sender address verified in your Brevo account.
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
# Optional: redirect every outbound supplier email to this address instead of the
# supplier's own contactEmail — useful for verifying real delivery in the demo without
# emailing the fixture's fictitious (.example, non-deliverable) supplier addresses.
SUPPLIER_EMAIL_OVERRIDE=